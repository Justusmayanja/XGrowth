APP_NAME=Xpulse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local with Docker: PostgreSQL + Redis (see docker-compose.yml)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xpulse
DB_USERNAME=xpulse
DB_PASSWORD=xpulse

# Fallback without Docker: use sqlite
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Final stage — X OAuth
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/api/auth/x/callback

# Final stage — OpenAI
OPENAI_API_KEY=

# Final stage — Billing
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
