APP_NAME=Mackie17
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL + Redis (recommended — run `docker compose up -d` from repo root)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xpulse
DB_USERNAME=xpulse
DB_PASSWORD=xpulse

# SQLite fallback (no Docker): set DB_CONNECTION=sqlite and comment out pgsql vars above

SESSION_DRIVER=database
SESSION_LIFETIME=120

# File cache and the database queue need no Redis. Spaceship has no queue daemon;
# schedule:run drains the database queue every minute. Use redis here only if a
# local Redis is actually running.
QUEUE_CONNECTION=database
CACHE_STORE=file

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sign-in codes. Port 465 uses implicit SSL (MAIL_SCHEME=smtps).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.spacemail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@mackie17.com
MAIL_FROM_NAME=Mackie17
MAIL_TIMEOUT=15
AUTH_CODE_TTL_MINUTES=10

# X account connection (not sign-in).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/api/auth/x/callback

# TikTok account linking. Leave empty until TikTok approves the app.
# Redirect URI must be the API callback and, once registered, HTTPS.
# Add video.upload to TIKTOK_SCOPES only after TikTok approves inbox upload.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic
# YouTube channel linking is separate from Google sign-in.
# YOUTUBE_SCOPES stays read-only. youtube.upload is a second consent, not this list.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/youtube/callback
YOUTUBE_SCOPES="https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly"
# false keeps inserts private, or holds a public/unlisted request on this server.
YOUTUBE_UPLOAD_AUDIT_APPROVED=false
# Shared videos.insert attempts per UTC day, across every user. Not the monthly allowance.
YOUTUBE_UPLOAD_DAILY_BUDGET=100
# App-side read budget. Search costs 101 units; channel videos cost 3; comments,
# views, and retention cost 1. Successful pulls are cached for this many minutes.
YOUTUBE_READ_QUOTA_DAILY=500
YOUTUBE_RESEARCH_CACHE_MINUTES=15
# Local transcription after a file is made. none keeps the paste box.
# openai calls Whisper. It does not call the YouTube Caption API and does not upload.
YOUTUBE_TRANSCRIPTION_DRIVER=none
YOUTUBE_TRANSCRIPTION_MODEL=whisper-1
# local writes a timed tone with ffmpeg. openai speaks the script. Neither uploads.
YOUTUBE_TTS_DRIVER=local
# Private videos stay on this server, under storage/app/private/media.
# MEDIA_LOCAL_ROOT can point that folder somewhere else on the same machine.
# Legacy local root, read by tiktok:migrate-videos. New files use storage/app/private/media/tiktok.
TIKTOK_VIDEO_ROOT=
# Each browser chunk is 1.5 MB, so the default 2M PHP upload limit can accept it.
TIKTOK_FFPROBE=ffprobe
TIKTOK_TTS_DRIVER=fake
TIKTOK_TTS_MODEL=gpt-4o-mini-tts
REDIS_QUEUE_RETRY_AFTER=900

# OpenAI — API key stays here; model & toggles are editable in Admin → Platform Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Legacy env fallbacks (admin Platform Settings override these at runtime)
OPENAI_WEB_SEARCH_ENABLED=true
OPENAI_GROWTH_BRAIN_ENABLED=true
OPENAI_GROWTH_EVAL_COOLDOWN=30
TREND_FETCH_TIMES=06:00,14:00,22:00
# Billing — set BILLING_GATEWAY to paddle or flutterwave, then add that gateway's keys.
# Webhook URLs:
#   {APP_URL}/api/billing/webhooks/paddle
#   {APP_URL}/api/billing/webhooks/flutterwave
BILLING_GATEWAY=paddle

# Paddle Billing. Use sandbox keys until PADDLE_ENVIRONMENT=live.
# PADDLE_VENDOR_ID is the old Classic API and is not used for checkout.
PADDLE_VENDOR_ID=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRODUCT_ID=

# Flutterwave. FLUTTERWAVE_WEBHOOK_SECRET is the dashboard secret hash (verif-hash).
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
